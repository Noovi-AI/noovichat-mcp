{
  "name": "@nooviai/noovichat-mcp",
  "version": "0.12.0",
  "description": "Model Context Protocol server for NooviChat — exposes Pipeline Pro, Follow-Ups, Atendimentos, Broadcasts, WhatsApp Templates, WAHA/UAZAPI and other custom NooviChat features as tools for Claude Desktop / Claude Code / Cursor / VS Code.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "noovichat",
    "chatwoot",
    "customer-engagement",
    "pipeline",
    "crm",
    "whatsapp",
    "waha",
    "uazapi",
    "follow-up",
    "broadcast",
    "claude",
    "claude-desktop",
    "anthropic"
  ],
  "license": "MIT",
  "homepage": "https://nooviai.com",
  "author": {
    "name": "Noovi",
    "email": "contato@nooviai.com",
    "url": "https://noovichat.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Noovi-AI/noovichat-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Noovi-AI/noovichat-mcp/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "noovichat-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "build:check": "tsc --noEmit",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check src tests",
    "lint:fix": "biome check --write src tests",
    "format": "biome format --write src tests",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "prepublishOnly": "pnpm build && pnpm check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.8",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
