# NooviChat instance base URL (no trailing slash)
NOOVICHAT_BASE_URL=https://chat.example.com

# API access token from NooviChat profile settings
NOOVICHAT_API_TOKEN=your-token-here

# Default account ID to use when not provided per-tool (optional)
NOOVICHAT_ACCOUNT_ID=1

# HTTP timeout in milliseconds (optional, default 30000)
NOOVICHAT_TIMEOUT_MS=30000
